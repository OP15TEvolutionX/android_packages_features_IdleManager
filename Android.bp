filegroup {
    name: "evolution-idle-manager-systemui-srcs",
    srcs: [
        "systemui/src/**/*.java",
        "systemui/src/**/*.kt",
    ],
    visibility: ["//frameworks/base/packages/SystemUI:__pkg__"],
}

filegroup {
    name: "evolution-idle-manager-settings-srcs",
    srcs: ["settings/src/**/*.kt"],
    visibility: ["//packages/apps/Settings:__pkg__"],
}
